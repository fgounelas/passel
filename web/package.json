    "ghostty-web": "0.4.0",
    "katex": "0.18.7",
    "lucide-react": "^0.562.0",
    "pdfjs-dist": "6.3.289",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "unified": "11.0.5"
