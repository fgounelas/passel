{
  "name": "@passel/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node ../scripts/copy-pdf-assets.mjs",
    "prebuild": "node ../scripts/copy-pdf-assets.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
